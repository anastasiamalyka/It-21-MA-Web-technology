<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Новий пост</title>
</head>
<body>
  <h1>Додати пост</h1>

  <% if (errors.length > 0) { %>
    <ul style="color: red;">
      <% errors.forEach(function(e) { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  <% } %>

  <form action="/posts" method="POST">
    <p>
      <label>Назва:</label><br>
      <input type="text" name="title" value="<%- old.title || '' %>">
    </p>

    <p>
      <label>Текст:</label><br>
      <textarea name="content" rows="6" cols="40"><%- old.content || '' %></textarea>
    </p>

    <p>
      <label>Теги (через кому, до 5):</label><br>
      <input type="text" name="tags" value="<%- old.tags || '' %>">
    </p>

    <p>
      <label>
        <input type="checkbox" name="published" <%= old.published ? 'checked' : '' %>>
        Опублікувати
      </label>
    </p>

    <button type="submit">Надіслати</button>
  </form>
</body>
</html>
